// nicelines multi-pass preset v9 (2026-02-14)
shaders = 5

// Pass 0: Downscale Blur + Horizontal Blur
shader0 = nicelines_blur.slang
filter_linear0 = false
scale_type0 = viewport
scale0 = 1.0
float_framebuffer0 = true
alias0 = Blur

// Pass 1: Scanlines
shader1 = nicelines_scanlines.slang
filter_linear1 = false
scale_type1 = viewport
scale1 = 1.0
float_framebuffer1 = true
alias1 = Scanlines

// Pass 2: Shadow Mask
shader2 = nicelines_mask.slang
filter_linear2 = false
scale_type2 = viewport
scale2 = 1.0
float_framebuffer2 = true
alias2 = Mask

// Pass 3: Halation Extraction (linear)
shader3 = nicelines_halation_extract.slang
filter_linear3 = false
scale_type3 = viewport
scale3 = 1.0
float_framebuffer3 = true
alias3 = HalationExtract

// Pass 4: Halation Blur + Final Output
shader4 = nicelines_halation.slang
filter_linear4 = false
scale_type4 = viewport
scale4 = 1.0
alias4 = Halation

feedback_pass = 0